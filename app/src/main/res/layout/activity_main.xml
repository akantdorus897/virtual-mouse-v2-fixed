<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/purple_500"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="کنترل کامل صفحه با موس شناور"
            android:textSize="14sp"
            android:textColor="@color/teal_200"
            android:layout_marginBottom="24dp"/>

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/menu_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="غیرفعال"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/holo_red_dark"/>

                <TextView
                    android:id="@+id/tvStatusDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="موس مجازی متوقف است"
                    android:textSize="12sp"
                    android:textColor="@color/menu_text"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sensitivity -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvSensitivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="حساسیت: 10"
                    android:textSize="16sp"
                    android:textColor="@color/menu_text"
                    android:layout_marginBottom="8dp"/>

                <SeekBar
                    android:id="@+id/seekSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="20"
                    android:progress="10"
                    android:progressTint="@color/purple_500"
                    android:thumbTint="@color/purple_500"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cursor Size -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvCursorSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اندازه نشانگر: 48"
                    android:textSize="16sp"
                    android:textColor="@color/menu_text"
                    android:layout_marginBottom="8dp"/>

                <SeekBar
                    android:id="@+id/seekCursorSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="80"
                    android:progress="48"
                    android:progressTint="@color/teal_200"
                    android:thumbTint="@color/teal_200"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cursor Shape -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cursor_shape"
                    android:textSize="16sp"
                    android:textColor="@color/menu_text"
                    android:layout_marginBottom="12dp"/>

                <RadioGroup
                    android:id="@+id/rgCursorShape"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/rbArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="پیکان"
                        android:buttonTint="@color/purple_500"/>

                    <RadioButton
                        android:id="@+id/rbHand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="دست"
                        android:buttonTint="@color/purple_500"/>

                    <RadioButton
                        android:id="@+id/rbCrosshair"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مرکز"
                        android:buttonTint="@color/purple_500"/>

                    <RadioButton
                        android:id="@+id/rbCircle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="دایره"
                        android:buttonTint="@color/purple_500"/>

                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cursor Color -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cursor_color"
                    android:textSize="16sp"
                    android:textColor="@color/menu_text"
                    android:layout_marginBottom="12dp"/>

                <RadioGroup
                    android:id="@+id/rgCursorColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/rbColorPurple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="بنفش"
                        android:buttonTint="@color/purple_500"/>

                    <RadioButton
                        android:id="@+id/rbColorWhite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="سفید"
                        android:buttonTint="@color/cursor_white"/>

                    <RadioButton
                        android:id="@+id/rbColorRed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="قرمز"
                        android:buttonTint="@color/cursor_red"/>

                    <RadioButton
                        android:id="@+id/rbColorGreen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="سبز"
                        android:buttonTint="@color/cursor_green"/>

                    <RadioButton
                        android:id="@+id/rbColorBlue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="آبی"
                        android:buttonTint="@color/cursor_blue"/>

                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Permissions Status -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اجازه‌های لازم"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/purple_500"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/llOverlayPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:id="@+id/ivOverlayStatus"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_delete"
                        android:tint="@android:color/holo_red_dark"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="نمایش روی سایر برنامه‌ها"
                        android:textSize="14sp"
                        android:textColor="@color/menu_text"
                        android:layout_marginStart="12dp"/>

                    <Button
                        android:id="@+id/btnEnableOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_overlay"
                        style="@style/Widget.MaterialComponents.Button.TextButton"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llAccessibilityPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:id="@+id/ivAccessibilityStatus"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_delete"
                        android:tint="@android:color/holo_red_dark"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="سرویس دسترسی (کلیک/اسکرول/انتخاب متن)"
                        android:textSize="14sp"
                        android:textColor="@color/menu_text"
                        android:layout_marginStart="12dp"/>

                    <Button
                        android:id="@+id/btnEnableAccessibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_accessibility"
                        style="@style/Widget.MaterialComponents.Button.TextButton"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llNotificationPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivNotificationStatus"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_delete"
                        android:tint="@android:color/holo_red_dark"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="اطلاع‌رسانی (کنترل از نوتیفیکشن)"
                        android:textSize="14sp"
                        android:textColor="@color/menu_text"
                        android:layout_marginStart="12dp"/>

                    <Button
                        android:id="@+id/btnEnableNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_notifications"
                        style="@style/Widget.MaterialComponents.Button.TextButton"/>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/start_mouse"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/stop_mouse"
                android:textSize="18sp"
                android:enabled="false"
                android:layout_marginTop="12dp"
                app:cornerRadius="28dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        </LinearLayout>

        <!-- Loading Ring -->
        <ProgressBar
            android:id="@+id/progressLoading"
            style="@style/Widget.MaterialComponents.CircularProgressIndicator"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/loading_ring"
            android:visibility="gone"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_text"
            android:textSize="14sp"
            android:textColor="@color/teal_200"
            android:visibility="gone"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
